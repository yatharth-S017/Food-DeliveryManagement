# ─── Database ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_HOST=localhost
MYSQL_PORT=3307

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_256bit_hex_jwt_secret_here
JWT_EXPIRATION=86400000

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
